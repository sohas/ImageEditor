				//	{
				//		Marshal.Copy(rawPixels, 0, bitmap.BackBuffer, rawPixels.Length);
				//		bitmap.AddDirtyRect(new Int32Rect(0, 0, width, height));
				//	}
				//	finally
				//	{
				//		bitmap.Unlock();
				//	}

				//	// 4. Замораживаем, чтобы объект стал потокобезопасным для UI-потока WPF
				//	bitmap.Freeze();


				//using (var reader = new itst.pdf.PdfReader(ms))
				//{
				//	while (count < reader.NumberOfPages)
				//	{
				//		var size = pageSizes[count];
				//		var sizeMax = Math.Max(size.Width, size.Height);
				//		var resolutionScale = sizeMax <= 24 * 72 ? 1 : 24 * 72 / sizeMax;//при больших размерах уменьшаем разрешение

				//		var pm = new PageModel(
				//			this,
				//			count++,
				//			size,
				//			(int)(PdfResolutionForView * resolutionScale),
				//			PdfResolutionForThumbnail);

				//		var pdfAnnotations = reader.ExtractPdfAnnotations(pm, count);
				//		pm.SetInitialPdfAnnotations(pdfAnnotations);
