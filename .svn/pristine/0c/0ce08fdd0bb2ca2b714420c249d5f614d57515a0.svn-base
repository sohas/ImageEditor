					int width = pageReader.GetPageWidth();
					int height = pageReader.GetPageHeight();
					var sizeMax = Math.Max(width, height);
					var resolutionScale = 1;//sizeMax <= 24 * 72 ? 1 : 24 * 72 / sizeMax;//при больших размерах уменьшаем разрешение

					var pm = new PageModel(
						this,
						count++,
						new Size(width, height),
						(int)(PdfResolutionForView * resolutionScale),
					PdfResolutionForThumbnail);

					//var pdfAnnotations = reader.ExtractPdfAnnotations(pm, count);
					//pm.SetInitialPdfAnnotations(pdfAnnotations);
					pm.PropertyChanged += (o, e) => OnPropertyChanged(e);
					pagesAll.Add(pm);
					pagesChosen.Add(pm);
				}




				//	byte[] rawPixels = pageReader.GetImage();

				//	// 3. Переносим массив в нативный WPF WriteableBitmap
				//	var bitmap = new WriteableBitmap(width, height, PdfResolutionForView, PdfResolutionForView, PixelFormats.Bgra32, null);

				//	bitmap.Lock();
