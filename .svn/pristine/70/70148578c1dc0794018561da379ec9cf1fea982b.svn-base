	public enum NotifiedPropertyType
	{
		IsSelectedSingle,
		IsSelectedMultiple,
		BitmapThumbnail,
		BitmapForView,
		PagesChosen,
		IsDeleted,
		PageNumberCurrent,
		PagesAll,
		DocumentNameChosen,
		PageNumberDisplayedSimple,
		RotateFlipType,
		ColorizeTypeChosen,
		CCC,
	}

	/// <summary>
	/// Перечисление типов обображения заметок
	/// </summary>
	public enum FilteringTiffAnnotationsType
	{
		HideAll = 0,
		ShowCurrentUserOnly = 1,
		ShowGroup = 2,
		ShowAll = 3,
	}

	/// <summary>
	/// Перечисление типов событий изменения
	/// </summary>
	public enum ModificationType
	{
		JustNotify,
		Add,
		Edit,
		Remove,
	}

	/// <summary>
	/// Перечисление типов изменения модели изображения
