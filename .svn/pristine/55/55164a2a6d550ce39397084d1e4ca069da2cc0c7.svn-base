		#region write to tiff
		private static void SetPageTiffTags(this Tiff output, int index, int numberOfPages)
		{
			output.SetField(TiffTag.SUBFILETYPE, FileType.PAGE);
			output.SetField(TiffTag.PAGENUMBER, index, numberOfPages);
		}

		private static void Set24bppTiffTags(this Tiff output, PageModel pm)
		{
			output.SetField(TiffTag.SAMPLESPERPIXEL, 3);
			output.SetField(TiffTag.BITSPERSAMPLE, 8);
			output.SetField(TiffTag.PHOTOMETRIC, Photometric.RGB);

			if (pm.ImageFileFormatOrigin == ImageFileFormat.Jpg)
			{
				output.SetField(TiffTag.COMPRESSION, Compression.JPEG);
			}
			else
			{
				output.SetField(TiffTag.COMPRESSION, Compression.DEFLATE);
			}

			output.SetField(TiffTag.PLANARCONFIG, PlanarConfig.CONTIG);
		}

		private static void Set8bppTiffTags(this Tiff output)
		{
			output.SetField(TiffTag.SAMPLESPERPIXEL, 1);
			output.SetField(TiffTag.BITSPERSAMPLE, 8);
			output.SetField(TiffTag.PHOTOMETRIC, Photometric.MINISWHITE);//иначе в ios получается негативное изображение
			output.SetField(TiffTag.COMPRESSION, Compression.DEFLATE);
			output.SetField(TiffTag.FILLORDER, FillOrder.MSB2LSB);
			output.SetField(TiffTag.STRIPOFFSETS, 0);
		}

		private static void SetSizeTiffTags(this Tiff output, int width, int height)
		{
			output.SetField(TiffTag.IMAGEWIDTH, width);
			output.SetField(TiffTag.IMAGELENGTH, height);
			output.SetField(TiffTag.ROWSPERSTRIP, height);
		}

		private static void SetResolutionInInchTiffTags(this Tiff output, float xRes, float yRes)
		{
			output.SetField(TiffTag.XRESOLUTION, xRes);
			output.SetField(TiffTag.YRESOLUTION, yRes);
			output.SetField(TiffTag.RESOLUTIONUNIT, ResUnit.INCH);
		}

		private static void WriteConvertedSamples(this Tiff output, byte[] raster, int width, int height, bool gray)
		{
			int stride = raster.Length / height;
			const int samplesPerPixel = 3;

			if (gray)//знаем, что растер полноцветный, но все каналы одинаковые. берём красный канал
			{
				for (int y = 0; y < height; y++)
				{
					int offset = stride * y;
					int strideEnd = offset + width * samplesPerPixel;

					var buffer = new byte[stride / samplesPerPixel];
					var j = 0;

					for (int i = offset; i < strideEnd; i += samplesPerPixel)
					{
						buffer[j++] = (byte)(255 - raster[i]);//потому что miniswhite!
					}

					output.WriteScanline([.. buffer], y);
				}
			}
			else
			{
				for (int y = 0; y < height; y++)
				{
					int offset = stride * y;
					int strideEnd = offset + width * samplesPerPixel;

					for (int i = offset; i < strideEnd; i += samplesPerPixel)
					{
						byte temp = raster[i + 2];
						raster[i + 2] = raster[i];
						raster[i] = temp;
					}

					output.WriteScanline(raster, offset, y, 0);
				}
			}
		}

		private static Rect GetNewTiffAnnotationBounds(Size cropSize, Rect oldTiffAnnotationBounds, RotateFlipType RotateFlipType)
		{
			//selection всегда x2 > x1, y2 > y1;
			var x1 = oldTiffAnnotationBounds.Left;
			var y1 = oldTiffAnnotationBounds.Top;
			var x2 = oldTiffAnnotationBounds.Right;
			var y2 = oldTiffAnnotationBounds.Bottom;
			var w0 = Math.Abs(x1 - x2);
			var h0 = Math.Abs(y1 - y2);

			Point p = new Point(x1, y1);
			Size s = new Size(w0, h0);

			switch (RotateFlipType)
			{
				case RotateFlipType.Rotate270FlipNone:
					p = new Point(y1, cropSize.Width - x2);
					s = new Size(h0, w0);
					break;
				case RotateFlipType.Rotate180FlipNone:
					p = new Point(cropSize.Width - x2, cropSize.Height - y2);
					break;
				case RotateFlipType.Rotate90FlipNone:
					p = new Point(cropSize.Height - y2, x1);
					s = new Size(h0, w0);
					break;
				case RotateFlipType.RotateNoneFlipX:
					p = new Point(cropSize.Width - x2, y1);
					break;
				case RotateFlipType.Rotate90FlipX:
					p = new Point(y1, x1);
					s = new Size(h0, w0);
					break;
				case RotateFlipType.Rotate180FlipX:
					p = new Point(x1, cropSize.Height - y2);
					break;
				case RotateFlipType.Rotate270FlipX:
					p = new Point(cropSize.Height - y2, cropSize.Width - x2);
					s = new Size(h0, w0);
					break;
				case RotateFlipType.RotateNoneFlipNone:
				default:
					break;
			}

			var res = new Rect(p.X, p.Y, s.Width, s.Height);
			return res;
		}

		private static bool CheckAndRotateTiffAnnotation(this TiffAnnotationItem tai, PageModel pm)
		{
			#region границы
			var b = tai.LrBounds.NormalizeRectangle();
			var s = pm.RectangleCrop.NormalizeRectangle();

			var dl = b.Left - s.Left;
			var dt = b.Top - s.Top;

			if (dl < 0 || dt < 0 || b.Right > s.Right || b.Bottom > s.Bottom)//проверка выхода аннотаций за границы кропа
			{
				return false;
			}

			var cropedBounds = new Rect(dl, dt, b.Width, b.Height);//координаты аннотаций после кропа
			tai.LrBoundsChosen = GetNewTiffAnnotationBounds(pm.RectangleCrop.Size, cropedBounds, pm.RotateFlipType);//координаты аннотаций с учётом поворота/отражения
			#endregion

			#region вращение/отражение
			tai.OiAnoDat_AN_NEW_ROTATE_STRUCT_Chosen = new AN_NEW_ROTATE_STRUCT();

			var startRotation = //в момент изменения или создания заметки фиксируем (0 - текущее значение RotationFlipType)
				tai.OiAnoDat_AN_NEW_ROTATE_STRUCT is null ?
				RotateFlipType.RotateNoneFlipNone :
				(RotateFlipType)(tai.OiAnoDat_AN_NEW_ROTATE_STRUCT.Rotation - 1);

			var newRotation = startRotation.Add(pm.RotateFlipType);
			tai.OiAnoDat_AN_NEW_ROTATE_STRUCT_Chosen.Rotation = (int)newRotation + 1;//записали поворот, который применим при отрисовке сохранённого файла
			#endregion

			return true;
		}

		private static void WriteTiffAnnotations(this Tiff output, PageModel pm, TiffAnnotationView tav)
		{
			if (pm.HasTiffAnnotations)
			{
				var ditasm = new DocumentImageTiffAnnotationsModel();

				foreach (var tam in pm.TiffAnnotations)
				{
					var tai = tam.TiffAnnotationItem;
					var oiGroup = tai.OiGroup;

					var canWrite =
						tav.FilteringTiffAnnotations == FilteringTiffAnnotationsType.ShowAll ||
						tav.FilteringTiffAnnotations == FilteringTiffAnnotationsType.ShowCurrentUserOnly &&
							tav.TiffAnnotationOiGroupCurrentUser == oiGroup ||
						tav.FilteringTiffAnnotations == FilteringTiffAnnotationsType.ShowGroup &&
							tav.TiffAnnotationOiGroups is not null && tav.TiffAnnotationOiGroups.Contains(oiGroup);

					if (canWrite && tai.CheckAndRotateTiffAnnotation(pm))
					{
						ditasm.TiffAnnotationItems.Add(tam.TiffAnnotationItem);
					}
				}

				if (ditasm.TiffAnnotationItems.Count > 0)
				{
					var ab = ditasm.GetAnnotationTiffBytes(true);
					output.SetField(ImageModel.OIAN_MARK_ATTRIBUTES, ab.Length, ab);
				}
			}
		}

		private static void WriteRGBRasterAsTiffDirectory(
			this Tiff output, PageModel pm, byte[] raster, BitmapSource parameters, int index, bool useMark, string mark, TiffAnnotationView tav)
		{
			var width = (int)parameters.Width;
			var height = (int)parameters.Height;
			var xRes = (int)parameters.DpiX;
			var yRes = (int)parameters.DpiY;
			var numberOfPages = pm.ImageModelParent.PagesChosen.Count();

			output.SetPageTiffTags(index, numberOfPages);
			output.SetSizeTiffTags(width, height);
			output.SetResolutionInInchTiffTags(xRes, yRes);

			if (useMark)
			{
				output.SetField(TiffTag.IMAGEDESCRIPTION, mark);
			}

			var toGrayScale =
				!(pm.HasStamps && pm.StampSaveTypeChosen == ExtraObjectsSaveType.Burn) &&
				!(pm.HasTiffAnnotations && pm.TiffAnnotationSaveTypeChosen == ExtraObjectsSaveType.Burn) &&
				(pm.ColorizeTypeChosen != ColorizeType.Colorize || pm.IsBWColorOrigin);

			var keepTiffAnnotations = pm.HasTiffAnnotations && pm.TiffAnnotationSaveTypeChosen == ExtraObjectsSaveType.Keep;

			if (keepTiffAnnotations)
			{
				output.WriteTiffAnnotations(pm, tav);
			}

			if (toGrayScale)
			{
				output.Set8bppTiffTags();
			}
			else
			{
				output.Set24bppTiffTags(pm);
			}

			output.WriteConvertedSamples(raster, width, height, toGrayScale);
			output.WriteDirectory();
		}

