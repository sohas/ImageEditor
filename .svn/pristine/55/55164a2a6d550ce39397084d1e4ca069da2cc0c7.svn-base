		public static byte[]? CopyImmutableArray(byte[] source)
		{
			if (source == null)
			{
				return null;
			}

			return [.. source];
		}

		public static bool IsFileLocked(this string filePath)
		{
			try
			{
				// Пытаемся открыть файл для чтения/записи без блокировки других
				using FileStream stream = new FileStream(
				    filePath,
				    FileMode.Open,
				    FileAccess.ReadWrite,
				    FileShare.None);
			}
			catch (IOException)
			{
				return true;
			}

			return false;
		}

		public static BitmapDecoder FindDecoderForTiffAndPlainImageAndSetFormat(this Stream stream, out ImageFileFormat imageFileFormat)
		{
			BitmapDecoder res;
			imageFileFormat = ImageFileFormat.Unknown;

			try
			{
				stream.Position = 0;
				res = new JpegBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand);
				imageFileFormat = ImageFileFormat.Jpg;
				return res;
			}
			catch { }
			try
			{
				stream.Position = 0;
				res = new GifBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand);
				imageFileFormat = ImageFileFormat.Gif;
				return res;
			}
			catch { }
			try
			{
				stream.Position = 0;
				res = new PngBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand);
				imageFileFormat = ImageFileFormat.Png;
				return res;
			}
			catch { }
			try
			{
				stream.Position = 0;
				res = new BmpBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand);
				imageFileFormat = ImageFileFormat.Bmp;
				return res;
			}
			catch { }
			try
			{
				stream.Position = 0;
				res = new TiffBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand);
				imageFileFormat = ImageFileFormat.Tiff;
				return res;
			}
			catch { }

			return null;
		}

		public static BitmapDecoder? GetDecoderForTiffAndPlainImage(this Stream stream, ImageFileFormat imageFileFormat)
		{
			return imageFileFormat switch
			{
				ImageFileFormat.Tiff => new TiffBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand),
				ImageFileFormat.Jpg => new JpegBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand),
				ImageFileFormat.Gif => new GifBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand),
				ImageFileFormat.Png => new PngBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand),
				ImageFileFormat.Bmp => new BmpBitmapDecoder(stream, BitmapCreateOptions.DelayCreation, BitmapCacheOption.OnDemand),
				_ => null,
			};
		}

