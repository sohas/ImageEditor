		/// <summary>
		/// Извлекает текст страницы Pdf-файла, если он там присутствует. 
		/// В некоторых случаях кодировка может быть нарушена.
		/// </summary>
		/// <param name="pm">модель страницы</param>
		/// <returns>извлечённый текст</returns>
		public static string ExtractPagePdfText(this PageModel pm)
		{
			string res = null;

			if (
				pm.ImageModelParent is ImageModel im &&
				pm.ImageFileFormatOrigin == ImageFileFormat.Pdf &&
				im.FileBytes is byte[] bts && bts.Any())
			{
				using var docReader = DocLib.Instance.GetDocReader(bts, new PageDimensions());
				using var pageReader = new OrderedPageTextReader(docReader, pm.PageNumberInitial);
				res = pageReader.GetTextInReadableOrder();
			}

			return res;
		}

		/// <summary>
		/// Извлекает тексты страниц Pdf-файла в виде списка в порядке следования страниц 
		/// оригинального файла (не в порядке страниц модели).
		/// При отсутствии текста на странице для этой страницы в список добавляется null.
		/// В некоторых случаях кодировка может быть нарушена.
		/// При невозможности извлечь, список возвращается как null
		/// </summary>
		/// <param name="im"></param>
		/// <returns>список текстов страниц</returns>
		public static List<string> ExtractAllPagesPdfText(this ImageModel im)
		{
			List<string> res = null;

			if (
				im.ImageFileFormatOrigin == ImageFileFormat.Pdf &&
				im.FileBytes is byte[] bts && bts.Any())
			{
				res = [];

				using var docReader = DocLib.Instance.GetDocReader(im.FileBytes, new PageDimensions());

				for (var i = 0; i < im.PagesAllCount; i++)
				{
					using var pageReader = new OrderedPageTextReader(docReader, i);
					res.Add(pageReader.GetTextInReadableOrder());
				}
			}

			return res;
		}

		/// <summary>
		/// подбирает размер изображения под размер рамки, максимально заполняя рамку
		/// </summary>
		/// <param name="outerSize"></param>
		/// <param name="heightDevidedByWidth"></param>
		/// <returns>размер изображения</returns>
		public static Size GetFitSize(this Size outerSize, double heightDevidedByWidth)
		{
			var w = outerSize.Width;
			var h = (w * heightDevidedByWidth);

			if (h > outerSize.Height)
			{
				h = outerSize.Height;
				w = (int)(h / heightDevidedByWidth);
			}

			return new Size(w, h);
		}


		/// <summary>
		/// вынимает базовый битмап страницы и применяет action к нему
		/// </summary>
		/// <param name="pm">PageModel страницы</param>
		/// <param name="action">то, что мы делаем с базовым битмапом</param>
		/// <param name="forThumbnail">true для построения небольших изображений</param>
		public static void ReadPageForAction(this PageModel pm, Action<BitmapSource?> action, bool forThumbnail = false)
		{
			if (action is null)
			{
				return;
			}

			try
			{
				if (pm.ImageModelParent.SourceType == SourceType.ImagesSource)
				{
					var pageImage = pm.ImageModelParent.ScanPagesInitial[pm.PageNumberInitial];
					action(pageImage);
				}
				else if (pm.ImageFileFormatOrigin == ImageFileFormat.Pdf)
				{
					action(pm.ImageModelParent?.ImageReader?.GetBitmapSource(pm, forThumbnail));
				}
				else if (pm.ImageFileFormatOrigin == ImageFileFormat.Tiff || pm.IsPlainImage)
				{
					using Stream ms0 = new MemoryStream(pm.ImageModelParent.FileBytes);
					var decoder = ms0.GetDecoderForTiffAndPlainImage(pm.ImageFileFormatOrigin);
					var frame = decoder.Frames[pm.PageNumberInitial];

					using MemoryStream ms = new MemoryStream();
					BmpBitmapEncoder encoder = new BmpBitmapEncoder();
					encoder.Frames.Add(frame);
					encoder.Save(ms);
					ms.Position = 0;

					var ths = ImageModel.ThumbnailSize.GetFitSize(frame.Height / frame.Width);

					BitmapImage finalBitmap = new BitmapImage();
					finalBitmap.BeginInit();
					finalBitmap.CacheOption = BitmapCacheOption.OnLoad; // Выкачиваем в ОЗУ мгновенно
					finalBitmap.StreamSource = ms;

					if (forThumbnail)
					{
						finalBitmap.DecodePixelWidth = (int)ths.Width;
						finalBitmap.DecodePixelHeight = (int)ths.Height;
					}

					finalBitmap.EndInit();
					finalBitmap.Freeze();

					action(finalBitmap);
				}
			}
			catch (Exception ex)
			{
				throw;
			}
		}
