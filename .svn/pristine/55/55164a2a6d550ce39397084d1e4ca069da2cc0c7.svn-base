		public static bool IsBWColorViaWindowsMedia(this BitmapSource bs, out bool isIndexed)
		{
			isIndexed = false;

			if (bs is null)
			{
				return false;
			}

			var format = bs.Format;

			if (
				format == PixelFormats.BlackWhite ||
				format == PixelFormats.Gray2 ||
				format == PixelFormats.Gray4 ||
				format == PixelFormats.Gray8 ||
				format == PixelFormats.Gray16 ||
				format == PixelFormats.Gray32Float ||
				false)
			{
				return true;
			}
			else if (
				format == PixelFormats.Indexed1 ||
				format == PixelFormats.Indexed2 ||
				format == PixelFormats.Indexed4 ||
				format == PixelFormats.Indexed8 ||
				false)
			{
				isIndexed = true;

				var palette = bs.Palette.Colors;

				if (palette is null)
				{
					return false;
				}

				foreach (var color in palette)
				{
					if (color.R != color.G || color.G != color.B)
					{
						return false;
					}
				}

				return true;
			}

			return false;
		}

