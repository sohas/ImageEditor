		public static byte[] GetDeepCopy(this byte[] source)
		{
			if (source is null)
			{
				return null;
			}

			var copy = new byte[source.Length];
			Buffer.BlockCopy(source, 0, copy, 0, copy.Length);
			return copy;
		}

		public static T[] GetDeepCopy<T>(this T[] source)
		{
			if (source is null)
			{
				return null;
			}

			T[] copy = new T[source.Length];
			Array.Copy(source, copy, source.Length);
			return copy;
		}

		public static bool IsSimilar<T>(this T[] array1, T[] array2)
		{
			if (array1 is not null && array2 is not null)
			{
				return array1.SequenceEqual(array2);
			}
			else
			{
				return array1 is null && array2 is null;
			}
		}

