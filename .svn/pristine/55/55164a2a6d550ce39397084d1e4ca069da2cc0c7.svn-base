		private static void WriteFileBytesToFile(this byte[] tiffBytes, string newFileName)
		{
			using var destFileStream = File.Open(newFileName, FileMode.Create, FileAccess.ReadWrite, FileShare.ReadWrite);
			destFileStream.Write(tiffBytes, 0, tiffBytes.Length);
			destFileStream.Flush();
			destFileStream.Close();
		}

		/// <summary>
		/// записывает Image Model в файл в заданном формате с учётом метки
		/// </summary>
		/// <param name="imageModel">модель</param>
		/// <param name="newFileName">имя файла, в который пишется</param>
		/// <param name="useMark">если true, то используем метку</param>
		/// <param name="mark">метка</param>
		/// <param name="tav">способ фильтрации заметок</param>
		/// <param name="testTiffTags">если true, то в случае ошибки копирования/записи tiff тагов при записи файла, не запускается лечение. нужно для тестирования проблемых форматов tiff</param>
		public static void WriteImageModelToFile(this ImageModel imageModel, string newFileName, bool useMark, string mark, TiffAnnotationView tav, bool testTiffTags = false) =>
			imageModel.GetImageModelBytes(useMark, mark, tav, testTiffTags).WriteFileBytesToFile(newFileName);

		/// <summary>
		/// возвращает байтовый массив, соответствующий файлу, в который сохраняется Image Model в заданном формате с учётом метки
		/// </summary>
		/// <param name="imageModel">модель</param>
		/// <param name="useMark">если true, то используем метку</param>
		/// <param name="mark">метка</param>
		/// <param name="tav">способ фильтрации заметок</param>
		/// <param name="testTiffTags">если true, то в случае ошибки копирования/записи tiff тагов при записи файла, не запускается лечение. нужно для тестирования проблемых форматов tiff</param>
		/// <returns>байтовый массив</returns>
		public static byte[] GetImageModelBytes(this ImageModel imageModel, bool useMark, string mark, TiffAnnotationView tav, bool testTiffTags = false)
		{
			if (!useMark && !imageModel.HasBeenModified)
			{
				return imageModel.FileBytes;
			}

			return imageModel.ImageFileFormatChosen switch
			{
				ImageFileFormat.Tiff => imageModel.GetImageModelTiffBytes(useMark, mark, tav, testTiffTags),
				ImageFileFormat.Pdf => imageModel.GetImageModelPdfBytes(useMark, mark, tav, testTiffTags),
				_ => imageModel.FileBytes,
			};
		}
		#endregion

		#region write to pdf
		private static void FillPdfMemoryStreamFromTiffStream(this Tiff tstream, MemoryStream mstream)
		{
			T2P t2p = new T2P
			{
				m_testFriendly = false,
				m_outputdisable = false,
				m_pdf_defaultcompression = t2p_compress_t.T2P_COMPRESS_ZIP,
				m_outputfile = mstream,
			};

			using var output2 = Tiff.ClientOpen("in-memory", "w", t2p, t2p.m_stream);
			if (output2 == null)
			{
				t2p.m_outputfile.Dispose();
				Tiff.Error(tstream, Tiff2PdfConstants.TIFF2PDF_MODULE, "Can't initialize output descriptor");
				return;
			}

			t2p.validate();
			object client = output2.Clientdata();
			TiffStream stream = output2.GetStream();
			stream.Seek(client, 0, SeekOrigin.Begin);
			t2p.write_pdf(tstream, output2);

			if (t2p.m_error)
			{
				t2p.m_outputfile.Dispose();
				Tiff.Error(tstream, Tiff2PdfConstants.TIFF2PDF_MODULE, "An error occurred creating output PDF file");
				return;
			}
		}

