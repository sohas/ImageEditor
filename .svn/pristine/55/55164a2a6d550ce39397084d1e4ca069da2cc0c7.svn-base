		#region geometry
		public static Point Plus(this Point a, Point b) => new Point(a.X + b.X, a.Y + b.Y);

		public static Point Minus(this Point a, Point b) => new Point(a.X - b.X, a.Y - b.Y);

		public static Point Reflect(this Point a) => new Point(-a.X, -a.Y);

		public static Point Mult(this Point a, double b) => new Point(a.X * b, a.Y * b);

		public static Point GetRotatedPoint(this Point p, float angleDegree)
		{
			var k = 1.0;
			var pX = p.X / k;
			var pY = p.Y / k;

			while (Math.Abs(pX) > 40000 || Math.Abs(pY) > 40000)//борьба с переполнением
			{
				k *= 2;
				pX /= k;
				pY /= k;
			}

			var r = k * Math.Sqrt(pX * pX + pY * pY);
			var angleInRadian = 2 * Math.PI * angleDegree / 360;

			var x = 0.0;
			var y = 0.0;

			if (p.Y != 0 || p.X != 0)
			{
				var angleInRadianNew = Math.Atan2(pY, pX) + angleInRadian;

				x = r * Math.Cos(angleInRadianNew);
				y = r * Math.Sin(angleInRadianNew);
			}

			return new Point((int)x, (int)y);
		}

		public static RotateFlipType Add(this RotateFlipType a, RotateFlipType b)
		{
			var i = (int)a;
			var j = (int)b;
			int res;

			if (i < 4 && j < 4)
			{
				res = (i + j) % 4;
			}
			else if (i < 4 && j >= 4)
			{
				res = (i + j) % 4 + 4;
			}
			else if (i >= 4 && j < 4)
			{
				res = (i - j + 8) % 4 + 4;
			}
			else
			{
				res = (i - j + 8) % 4;
			}

			return (RotateFlipType)res;
		}

		public static RotateFlipType Substract(this RotateFlipType a, RotateFlipType b)
		{
			var i = (int)a;
			var j = (int)b;
			int res;

			if (i < 4 && j < 4 || i >= 4 && j >= 4)
			{
				res = (i - j + 4) % 4;
			}
			else
			{
				res = (i + j) % 4 + 4;
			}

			return (RotateFlipType)res;
		}

		public static Rect NormalizeRectangle(this Rect rec)
		{
			var x = Math.Min(rec.Left, rec.Right);
			var y = Math.Min(rec.Top, rec.Bottom);
			var w = Math.Abs(rec.Width);
			var h = Math.Abs(rec.Height);

			return new Rect(x, y, w, h);
		}
