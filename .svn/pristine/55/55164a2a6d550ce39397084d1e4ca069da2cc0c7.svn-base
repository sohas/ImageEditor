		private static byte[] GetRGBByteRasterFromPageModel(this PageModel pm, out BitmapSource parameters, TiffAnnotationView tav)
		{
			var pageImage =
				pm.ImageModelParent.SourceType != SourceType.ImagesSource ? pm.BitmapForView :
				pm.ImageModelParent.ScanPagesInitial[pm.PageNumberInitial];

			return pm.GetRGBByteRasterFromBitmap(pageImage, out parameters, tav);
		}

		private static void CopyAllTagsExceptTiffAnnotations(Tiff input, Tiff output)
		{
			var problemTags = new HashSet<TiffTag>() //таги, наличие которых приводит к сбою
			{
				TiffTag.GROUP4OPTIONS,
				TiffTag.GROUP3OPTIONS,
				TiffTag.COLORMAP,
			};

			for (ushort t = ushort.MinValue; t < ushort.MaxValue && t != 32932; ++t)//кроме аннотаций
			{
				TiffTag tag = (TiffTag)t;

				if (input.GetField(tag) is FieldValue[] tagValue && !problemTags.Contains(tag))
				{
					output.GetTagMethods().SetField(output, tag, tagValue);
				}
			}

			int height = input.GetField(TiffTag.IMAGELENGTH)[0].ToInt();
			output.SetField(TiffTag.ROWSPERSTRIP, height);
			output.SetField(TiffTag.SOFTWARE, "DocumentImageEditor");
		}

		private static byte[] RasterToRgbBuffer(this int[] raster)
		{
			byte[] buffer = new byte[raster.Length * 3];

			for (int i = 0; i < raster.Length; i++)
			{
				Buffer.BlockCopy(raster, i * 4, buffer, i * 3, 3);
			}

			return buffer;
		}

		private static byte[] RasterToGrayBuffer(byte[] raster)
		{
			byte[] buffer = new byte[raster.Length / 3];

			for (int i = 0; i < buffer.Length; i++)
			{
				var r = raster[i * 3];
				var g = raster[i * 3 + 1];
				var b = raster[i * 3 + 2];
				var c = (byte)(255 - (0.3 * r + 0.59 * g + 0.11 * b));//потому что miniswhite!

				buffer[i] = c;
			}

			return buffer;
		}

		private static byte[] RasterToBWBuffer(byte[] raster)
		{
			byte[] buffer = new byte[raster.Length / 3];

			for (int i = 0; i < buffer.Length; i++)
			{
				var r = raster[i * 3];
				var g = raster[i * 3 + 1];
				var b = raster[i * 3 + 2];

				var c = (byte)(0.3 * r + 0.59 * g + 0.11 * b);
				c = c > (byte)127 ? (byte)0 : (byte)255;//потому что miniswhite!
				buffer[i] = c;
			}

			return buffer;
		}

		private static int[] Rotate(int[] buffer, RotateFlipType rotateFlipType, Rect cropSelection, ref int width, ref int height)
		{
			int rotatedWidth = (int)cropSelection.Width;
			int rotatedHeight = (int)cropSelection.Height;

			if (((int)rotateFlipType) % 2 == 1)
			{
				int tmp = rotatedWidth;
				rotatedWidth = rotatedHeight;
				rotatedHeight = tmp;
			}

			int[] rotated = new int[rotatedWidth * rotatedHeight];

			for (int h = 0; h < cropSelection.Height; ++h)
			{
				for (int w = 0; w < cropSelection.Width; ++w)
				{
					int item = buffer[(h + (int)cropSelection.Top) * width + w + (int)cropSelection.Left];
					int x;
					int y;

					switch (rotateFlipType)
					{
						case RotateFlipType.Rotate90FlipNone://1
							x = rotatedWidth - h - 1;
							y = w;
							break;

						case RotateFlipType.Rotate180FlipNone://2
							x = rotatedWidth - w - 1;
							y = rotatedHeight - h - 1;
							break;

						case RotateFlipType.Rotate270FlipNone://3
							x = h;
							y = rotatedHeight - w - 1;
							break;

						case RotateFlipType.RotateNoneFlipX://4
							x = rotatedWidth - w - 1;
							y = h;
							break;

						case RotateFlipType.Rotate90FlipX://5
							x = h;
							y = w;
							break;

						case RotateFlipType.Rotate180FlipX://6
							x = w;
							y = rotatedHeight - h - 1;
							break;

						case RotateFlipType.Rotate270FlipX://7
							x = rotatedWidth - h - 1;
							y = rotatedHeight - w - 1;
							break;

						case RotateFlipType.RotateNoneFlipNone://0
						default:
							x = w;
							y = h;
							break;
					}

					rotated[y * rotatedWidth + x] = item;
				}
			}

			width = rotatedWidth;
			height = rotatedHeight;

			return rotated;
		}

		//запасной вариант в случае ошибки, связанной с необрабатываемыми тегами
		private static void CureTiffTagProblems(this Tiff output, PageModel pm, int index, bool useMark, string mark, TiffAnnotationView tav)
		{
			var raster = pm.GetRGBByteRasterFromPageModel(out BitmapSource parameters, tav);

			if (raster is null)
			{
				return;
			}

			output.CreateDirectory();//пересоздаём заново
			var pageIndex = Convert.ToInt16(pm.PageNumberInitial);
			output.SetDirectory(pageIndex);
			pm.TiffAnnotationSaveTypeChosen = //в этом случае, если сохраняются заметки, то они прожигаются. иначе файл пишется с ошибками
				pm.TiffAnnotationSaveTypeChosen == ExtraObjectsSaveType.Keep ?
				ExtraObjectsSaveType.Burn :
				pm.TiffAnnotationSaveTypeChosen;
			output.WriteRGBRasterAsTiffDirectory(pm, raster, parameters, index, useMark, mark, tav);
		}

		private static void WriteNotMergedTiffPageModelToTiffDirectory(
			this Tiff output, PageModel pm, int index, bool useMark, string mark, TiffAnnotationView tav, bool testTiffTags = false)
		{
			using (MemoryStream ms = new MemoryStream(pm.ImageModelParent.FileBytes))
			using (Tiff input = Tiff.ClientOpen("InMemory", "r", ms, new TiffStream()))
			{
				var keepTiffAnnotations = pm.HasTiffAnnotations && pm.TiffAnnotationSaveTypeChosen == ExtraObjectsSaveType.Keep;

				if (keepTiffAnnotations)
				{
					output.WriteTiffAnnotations(pm, tav);
				}

				var pageIndex = Convert.ToInt16(pm.PageNumberInitial);
				input.SetDirectory(pageIndex);
				CopyAllTagsExceptTiffAnnotations(input, output);
				output.SetPageTiffTags(index, pm.ImageModelParent.PagesChosen.Count());

				if (useMark)
				{
					output.SetField(TiffTag.IMAGEDESCRIPTION, mark);
				}

				int width = input.GetField(TiffTag.IMAGEWIDTH)[0].ToInt();
				int height = input.GetField(TiffTag.IMAGELENGTH)[0].ToInt();

				int[] raster = new int[width * height];
				input.ReadRGBAImageOriented(width, height, raster, Orientation.TOPLEFT);
				raster = Rotate(raster, pm.RotateFlipType, pm.RectangleCrop, ref width, ref height);
				output.SetSizeTiffTags(width, height);
				byte[] strip = RasterToRgbBuffer(raster);

				if (pm.ColorizeTypeChosen != ColorizeType.Colorize || pm.IsBWColorOrigin)
				{
					output.Set8bppTiffTags();

					if (pm.ColorizeTypeChosen == ColorizeType.BW)
					{
						strip = RasterToBWBuffer(strip);
					}
					else
					{
						strip = RasterToGrayBuffer(strip);
					}

					byte[] buf = new byte[width];

					for (int i = 0; i < height; ++i)
					{
						Array.Copy(strip, i * width, buf, 0, width);
						output.WriteScanline(buf, i);
					}
				}
				else
				{
					if (input.GetField(TiffTag.SAMPLESPERPIXEL)[0].ToInt() != 3)
					{
						output.Set24bppTiffTags(pm);
					}

					output.WriteEncodedStrip(0, strip, strip.Length);
				}
			}

			if (testTiffTags)//для тестирования проблемных тагов. ошибка не глушится
			{
				output.WriteDirectory();
			}
			else
			{
				try
				{
					output.WriteDirectory();
				}
				catch //непредсказуемое сочетание тагов, приводящее к ошибке
				{
					output.CureTiffTagProblems(pm, index, useMark, mark, tav);
				}
			}
		}

		private static void WritePageModelToTiffDirectory(
			this Tiff output, PageModel pm, int index, bool useMark, string mark, TiffAnnotationView tav, bool testTiffTags = false)
		{
			if (
				pm.ImageFileFormatOrigin == ImageFileFormat.Tiff && !(pm.HasStamps && pm.StampSaveTypeChosen == ExtraObjectsSaveType.Burn ||
				pm.HasTiffAnnotations && pm.TiffAnnotationSaveTypeChosen == ExtraObjectsSaveType.Burn))
			{
				output.WriteNotMergedTiffPageModelToTiffDirectory(pm, index, useMark, mark, tav, testTiffTags);
			}
			else
			{
				var raster = pm.GetRGBByteRasterFromPageModel(out BitmapSource parameters, tav);

				if (raster is null)
				{
					return;
				}

				output.WriteRGBRasterAsTiffDirectory(pm, raster, parameters, index, useMark, mark, tav);
			}
		}

		private static byte[] GetImageModelTiffBytes(this ImageModel imageModel, bool useMark, string mark, TiffAnnotationView tav, bool testTiffTags = false)
		{
			if (!useMark && !imageModel.HasBeenModified)
			{
				return imageModel?.FileBytes;
			}

			var pagesSorted = imageModel?.GetSortedPages().ToList();
			var index = 0;

			if (pagesSorted?.Count == 0)
			{
				return null;
			}

			using var msOutput = new MemoryStream();
			using var output = Tiff.ClientOpen("in-memory", "w", msOutput, new TiffStream());
			foreach (var pm in pagesSorted)
			{
				mark = index == 0 ? mark : null;
				output.WritePageModelToTiffDirectory(pm, index++, useMark, mark, tav, testTiffTags);
			}

			return msOutput.ToArray();
		}
		#endregion
	}
}