		protected bool IsButtonShowThumbnailsOn//состояние нажатия кнопки постоянного выделения фрагмента
		{
			get => isButtonShowThumbnailsOn;
			set
			{
				if (isButtonShowThumbnailsOn != value)
				{
					isButtonShowThumbnailsOn = value;

					if (isButtonShowThumbnailsOn)
					{
						buttonShowThumbnails.Background = Brushes.White;
						gridPage.ColumnDefinitions[0].Width = thumbnailPanelLenghtLast;
					}
					else
					{
						thumbnailPanelLenghtLast = gridPage.ColumnDefinitions[0].Width;
						buttonShowThumbnails.Background = SystemColors.ControlBrush;
						gridPage.ColumnDefinitions[0].Width = new GridLength(0, GridUnitType.Pixel );
					}
				}
			}
		}

		public ImageEditor(ControlSettings controlSettings, ImageCacheSettings imageCacheSettings, ILogger logger)
		{
			this.controlSettings = controlSettings;
			this.imageCacheSettings = imageCacheSettings;
			this.logger = logger;
			this.editorDispatcher = new ParallelChainDispatcher<ImageOperationID>(logger);

			this.canSelectFragment = this.controlSettings.HasFlag(ControlSettings.CanSelectFragment);
			this.showUndoRedo = this.controlSettings.HasFlag(ControlSettings.ShowUndoRedo);
			this.canScale = this.controlSettings.HasFlag(ControlSettings.CanScale);
			this.canChangeFileName = this.controlSettings.HasFlag(ControlSettings.CanChangeFileName);
			this.useViewTools = this.controlSettings.HasFlag(ControlSettings.UseViewTools);
			this.useSaveTools = this.controlSettings.HasFlag(ControlSettings.UseSaveTools);
			this.useInfoTools = this.controlSettings.HasFlag(ControlSettings.UseInfoTools);
			this.canShiftPages = this.controlSettings.HasFlag(ControlSettings.CanShiftPages);
			this.canDeletePages = this.controlSettings.HasFlag(ControlSettings.CanDeletePages);
			this.canAddExtraFiles = this.controlSettings.HasFlag(ControlSettings.CanAddExtraFiles);
			this.canSetStamps = this.controlSettings.HasFlag(ControlSettings.CanSetStamps);
			this.canSetTiffAnnotations = this.controlSettings.HasFlag(ControlSettings.CanSetTiffAnnotations);
			this.canCrop = this.controlSettings.HasFlag(ControlSettings.CanCrop);
			this.canFlipPage = this.controlSettings.HasFlag(ControlSettings.CanFlipPage);
			this.savePageView = this.controlSettings.HasFlag(ControlSettings.SavePageView);
			this.canSelectPagesMultiple = this.controlSettings.HasFlag(ControlSettings.CanSelectPagesMultiple);
			this.showSaveStamps = this.controlSettings.HasFlag(ControlSettings.ShowSaveStamps);

			InitializeComponent();
		}

		#region public methods
		public void LoadFile(string filename)
		{
			var id = new ImageOperationID(ImageOperationType.BuildImageModel, filename);
			editorDispatcher.CancelMainChain();
			editorDispatcher.EnqueueMain(GetDispatched(LoadFileDispatched(filename), id));
		}

		#region old
		public static string GetAnotationTypeName(ExtraObjectsSaveType annotationSaveType)
		{
			return annotationSaveType switch
			{
				ExtraObjectsSaveType.Lose => loseAnnotationsName,
				ExtraObjectsSaveType.Burn => burnAnnotationsName,
				_ => keepAnnotationsName,
			};
		}

		public static string GetStampTypeName(ExtraObjectsSaveType annotationSaveType)
		{
			return annotationSaveType switch
			{
				ExtraObjectsSaveType.Lose => loseStampsName,
				_ => burnStampsName,
			};
		}

		public static string GetColorizeTypeName(ColorizeType colorizeType)
		{
			return colorizeType switch
			{
				ColorizeType.Gray => grayName,
				ColorizeType.BW => bwName,
				_ => colorizeName,
			};
		}

		public static string GetDrawSizeTypeName(DrawSizeType drawSizeType, double scale)
		{
			return drawSizeType switch
			{
				DrawSizeType.PhysicalSize => physicalSizeName,
				DrawSizeType.FitToWindow => fitToWindowName,
				DrawSizeType.FitToHeight => fitToHeightName,
				DrawSizeType.FitToWidth => fitToWidthName,
				_ => $" {Math.Round(scale * 100)}%",
			};
		}

		public static string GetImageFileFormatName(ImageFileFormat imageFileFormat) =>
			imageFileFormat == ImageFileFormat.Unknown ? "?" : $"{imageFileFormat}";
		#endregion

