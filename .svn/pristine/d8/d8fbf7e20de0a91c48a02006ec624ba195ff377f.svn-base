namespace ImageEditorControl.Models.TiffAnnotations
{
	/// <summary>
	/// В OiFilNam для Form, Image Embedded, Image Reference
	/// </summary>
	public class AN_NAME_STRUCT
	{
		/// <summary>
		/// A character string designating the filename; terminated with a NULL.
		/// </summary>
		public string Name { get; set; }

		public AN_NAME_STRUCT Clone() =>
			new AN_NAME_STRUCT {Name = this.Name};
	}
}