		/// <summary>
		/// переносит панель из её текущего родителя в новый контрол
		/// </summary>
		/// <param name="panel">панель, которая переносится</param>
		/// <param name="element">контрол, в который переносится панель</param>
		/// <param name="haveBeenUsed">условия разрешения переноса</param>
		/// <returns>при успешном переносе -- перенесённая панель, иначе null</returns>
		public static WrapPanel SetPanelOut(this WrapPanel panel, FrameworkElement element, ref bool haveBeenUsed)
		{
			if (!haveBeenUsed && panel is not null && element is not null)
			{
				var parent = panel.Parent;

				if (parent is not null)
				{
					if (parent is Panel parentPanel)
					{
						parentPanel.Children.Remove(panel);
					}
					else if (parent is ContentControl parentContentControl)
					{
						parentContentControl.Content = null;
					}
					else if (parent is Decorator parentDecorator)
					{
						parentDecorator.Child = null;
					}
					else
					{
						return null;
					}
				}

				panel.Visibility = Visibility.Visible;

				if (element is Panel outerPanel)
				{
					outerPanel.Children.Add(panel);
				}
				else if (element is ContentControl outerControl)
				{
					outerControl.Content = panel;
				}
				else if (element is Decorator outerDecorator)
				{
					outerDecorator.Child = panel;
				}
				else
				{
					return null;
				}

				haveBeenUsed = true;

				return panel;
			}

			return null;
		}
	}
