using ImageEditorControl.Models;
using System.Linq;

namespace ImageEditorControl.Undo
{
	public class UndoStampAdd(PageModel pm, StampModel sm) : UndoAbstract(pm)
	{
		private readonly StampModel sm = sm;

		public override bool NeedToRedrawPagePreview => true;

		public override void Undo()
		{
			if (
				sm is not null && pm is not null &&
				pm.Stamps.FirstOrDefault(x => x.Index == sm.Index) is StampModel sms)
			{
				pm.Stamps.Remove(sms);

				if (pm.StampSelected == sms)
				{
					pm.DeselectAllStamps();
				}

				SelectPageModel();
			}
		}

		public override UndoAbstract MakeUndoCloneUnsafe(ImageModel imageModelClone)
		{
			if (pm is not null && Im is not null)
			{
				var pmClone = imageModelClone.GetPageModelByPageNumberInitial(pm.PageNumberInitial);
				var smClone = sm?.Clone(pmClone);

				if (pmClone is not null && smClone is not null)
				{
					return new UndoStampAdd(pmClone, smClone);
				}
			}

			return new UndoStop();
		}

		public override UndoAbstract MakeRedoObject() => new UndoStampRemove(pm, sm);
	}
}