using System.ComponentModel;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;
using ImageEditorControl.Tools;
using ImageEditorControl.UIs;

namespace ImageEditorApp
{
	public class MainWindow : Window
	{
		private static readonly ComponentResourceManager resources = new ComponentResourceManager(typeof(MainWindow));
		private readonly static string openName = resources.GetString("openName");
		private readonly static string reloadName = resources.GetString("reloadName");
		private readonly static string addName = resources.GetString("addName");
		private readonly static string saveName = resources.GetString("saveName");
		private readonly static string printName = resources.GetString("printName");
		private readonly static string scanName = resources.GetString("scanName");
		private readonly static string noScannersName = resources.GetString("noScannersName");
		private readonly static string noScansName = resources.GetString("noScansName");
		private readonly static string buildCopyName = resources.GetString("buildCopyName");

		private readonly ImageEditor editor;
		private readonly ControlSettings editorSettings;
		private readonly ImageEditorAppLogger logger = new ImageEditorAppLogger();

		private readonly Button buttonOpen = new Button();
		private readonly Button buttonAdd = new Button();
		private readonly Button buttonBuildCopy = new Button();
		private readonly Button buttonSave = new Button();
		private readonly Button buttonScan = new Button();
		private readonly Button buttonReload = new Button();
		private readonly Button buttonPrint = new Button();

		private readonly Grid tableLayoutPanelMain = new Grid();
		private readonly WrapPanel flowLayoutPanelTools = new WrapPanel();
		private readonly WrapPanel panelFiles = new WrapPanel();
		private readonly Grid splitContainerMain = new Grid();
		private readonly ListView listViewFiles = new ListView();

		public MainWindow()
		{
			editor = new ImageEditor();
			editorSettings =
				ControlSettings.All
				^ ControlSettings.UseSaveTools
				^ ControlSettings.UseViewTools
				^ ControlSettings.UseInfoTools;
			editor.SetControlSettings(editorSettings);
			editor.SetImageCacheSettings(ImageCacheSettings.InternalCache);
			editor.SetLogger(logger);

			InitializeComponent();
		}

		private void InitializeComponent()
		{

			SetupButton(buttonOpen, openName);
			SetupButton(buttonAdd, addName);
			SetupButton(buttonBuildCopy, buildCopyName);
			SetupButton(buttonSave, saveName);
			SetupButton(buttonReload, reloadName);

			ColumnDefinition filesColumn = new ColumnDefinition();
			filesColumn.Width = new GridLength(1, GridUnitType.Star);
			Grid.SetColumn(listViewFiles, 0);
			splitContainerMain.Children.Add(listViewFiles);

			ColumnDefinition splitterColumn = new ColumnDefinition();
			splitterColumn.Width = GridLength.Auto;
			GridSplitter splitter = new GridSplitter
			{
				Width = 6,                                       // Ширина сплиттера должна совпадать с шириной столбца сетки
				HorizontalAlignment = HorizontalAlignment.Center, // Растягиваем на всю ширину ячейки
				VerticalAlignment = VerticalAlignment.Stretch,   // Растягиваем по вертикали окна
				Background = Brushes.Blue,                        // Цвет разделителя
			};
			splitter.ResizeBehavior = GridResizeBehavior.PreviousAndNext;
			Grid.SetColumn(splitter, 1);
			splitContainerMain.Children.Add(splitter);

			ColumnDefinition editorColumn = new ColumnDefinition();
			editorColumn.Width = new GridLength(1, GridUnitType.Star);
			Grid.SetColumn(editor, 2);
			splitContainerMain.Children.Add(editor);

			var i = 0;

			RowDefinition appToolRow = new RowDefinition();
			appToolRow.Height = GridLength.Auto;
			tableLayoutPanelMain.RowDefinitions.Add(appToolRow);
			Grid.SetRow(flowLayoutPanelTools, i++);
			tableLayoutPanelMain.Children.Add(flowLayoutPanelTools);

			if (!editorSettings.HasFlag(ControlSettings.UseSaveTools))
			{
				RowDefinition saveToolRow = new RowDefinition();
				saveToolRow.Height = GridLength.Auto;
				tableLayoutPanelMain.RowDefinitions.Add(saveToolRow);
				Grid.SetRow(editor.SetFlowLayoutPanelSaveToolsOut(tableLayoutPanelMain), i++);
			}

			if (!editorSettings.HasFlag(ControlSettings.UseViewTools))
			{
				RowDefinition viewToolRow = new RowDefinition();
				viewToolRow.Height = GridLength.Auto;
				tableLayoutPanelMain.RowDefinitions.Add(viewToolRow);
				Grid.SetRow(editor.SetFlowLayoutPanelViewToolsOut(tableLayoutPanelMain), i++);
			}

			RowDefinition contentRow = new RowDefinition();
			contentRow.Height = new GridLength(100, GridUnitType.Star);
			tableLayoutPanelMain.RowDefinitions.Add(contentRow);
			Grid.SetRow(splitContainerMain, i++);
			tableLayoutPanelMain.Children.Add(splitContainerMain);
			splitContainerMain.Background = Brushes.Red;

			if (!editorSettings.HasFlag(ControlSettings.UseInfoTools))
			{
				RowDefinition infoToolRow = new RowDefinition();
				infoToolRow.Height = GridLength.Auto;
				tableLayoutPanelMain.RowDefinitions.Add(infoToolRow);
				Grid.SetRow(editor.SetFlowLayoutPanelInfoToolsOut(tableLayoutPanelMain), i++);
			}

			this.Content = tableLayoutPanelMain;
		}

		private void SetupButton(Button button, string text)
		{
			button.Background = Brushes.Transparent;// new SolidColorBrush( SystemColors.ControlColor);
			button.HorizontalAlignment = HorizontalAlignment.Center;
			button.Height = 23;
			button.BorderThickness = new Thickness(0);
			button.Padding = new Thickness(10, 2, 10, 2);
			button.Margin = new Thickness(2);
			button.Content = text;
			flowLayoutPanelTools.Children.Add(button);
		}
	}
}