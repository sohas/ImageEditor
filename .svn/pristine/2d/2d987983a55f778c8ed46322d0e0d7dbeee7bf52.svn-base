<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Images\ImageDropDownArrow.bmp" />
    <None Remove="Resources\Images\ImageFlipX.bmp" />
    <None Remove="Resources\Images\ImageFlipY.bmp" />
    <None Remove="Resources\Images\ImageMoveCursor.bmp" />
    <None Remove="Resources\Images\ImageMoveCursor2.bmp" />
    <None Remove="Resources\Images\ImageMultySelect.bmp" />
    <None Remove="Resources\Images\ImageNextPage.bmp" />
    <None Remove="Resources\Images\ImageOutline.bmp" />
    <None Remove="Resources\Images\ImagePreviousPage.bmp" />
    <None Remove="Resources\Images\ImageRedo.bmp" />
    <None Remove="Resources\Images\ImageRotateL.bmp" />
    <None Remove="Resources\Images\ImageRotateR.bmp" />
    <None Remove="Resources\Images\ImageShowThumbnails.bmp" />
    <None Remove="Resources\Images\ImageSizeDown.bmp" />
    <None Remove="Resources\Images\ImageSizeUp.bmp" />
    <None Remove="Resources\Images\ImageUndo.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocNetExtended" Version="0.5.0.1" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OperationDispatcher\OperationDispatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Tiff2Pdf">
      <HintPath>..\_Assemblies\Tiff2Pdf.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\ImageRotateL.bmp" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\ImageDropDownArrow.bmp" />
    <Resource Include="Resources\Images\ImageFlipX.bmp" />
    <Resource Include="Resources\Images\ImageFlipY.bmp" />
    <Resource Include="Resources\Images\ImageMoveCursor.bmp" />
    <Resource Include="Resources\Images\ImageMoveCursor2.bmp" />
    <Resource Include="Resources\Images\ImageMultySelect.bmp" />
    <Resource Include="Resources\Images\ImageNextPage.bmp" />
    <Resource Include="Resources\Images\ImageOutline.bmp" />
    <Resource Include="Resources\Images\ImagePreviousPage.bmp" />
    <Resource Include="Resources\Images\ImageRedo.bmp" />
    <Resource Include="Resources\Images\ImageRotateR.bmp" />
    <Resource Include="Resources\Images\ImageShowThumbnails.bmp" />
    <Resource Include="Resources\Images\ImageSizeDown.bmp" />
    <Resource Include="Resources\Images\ImageSizeUp.bmp" />
    <Resource Include="Resources\Images\ImageUndo.bmp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
