		private void ReloadFile(object _, EventArgs __)
		{
			//editor.ReloadImageModelAsync();
		}

		private void UpdateLabels(string fileName)
		{
			if (!File.Exists(fileName))
			{
				return;
			}

			if (!string.IsNullOrEmpty(fileName))
			{
				fileInfoCurrent = new FileInfo(fileName);

				if (fileInfoCurrent is not null && fileInfoCurrent.Exists)
				{
					directoryInfoCurrent = fileInfoCurrent.Directory;
				}
				else
				{
					fileInfoCurrent = null;
				}
			}

			directoryInfoCurrent = directoryInfoCurrent is null ? null : new DirectoryInfo(directoryInfoCurrent.FullName);//заново строим, так как содержание директории могло измениться
			var newFiles = directoryInfoCurrent is null || !directoryInfoCurrent.Exists ? new FileInfo[0] : directoryInfoCurrent.GetFiles();//файлы новой директории

			//для построения лейблов файлов
			var newFilesForLabels = newFiles.Select(x => x.FullName).Except(currentDirectoryFilesLast.Select(y => y.FullName));//не было лейблов
			var missedFilesForLabels = currentDirectoryFilesLast.Select(x => x.FullName).Except(newFiles.Select(y => y.FullName));//были лейблы, но файлов уже нет

			if (newFilesForLabels.Any() || missedFilesForLabels.Any())//если список файлов изменился
			{
				currentDirectoryFilesLast.Clear();
				currentDirectoryFilesLast.AddRange(newFiles);
			}

			listViewFiles.ItemsSource = newFiles;
		}

		private void SelectNewFile(string fileName)
		{
			if (string.IsNullOrEmpty(fileName))
			{
				//this.documentImageEditorControl.LoadFileAsync(null);
			}
			else
			{
				fileName = Path.GetFullPath(fileName);
				var items = listViewFiles.ItemsSource as IEnumerable<FileInfo>;
				var itemToSelect = items?.FirstOrDefault(f => string.Equals(f.FullName, fileName, StringComparison.OrdinalIgnoreCase));

				if (itemToSelect != null)
				{
					listViewFiles.SelectedItem = itemToSelect;
					listViewFiles.ScrollIntoView(itemToSelect);
				}
			}
		}

		private void OpenSelectedFile(object _, SelectionChangedEventArgs e)
		{
			var item = listViewFiles.SelectedValue;

			if (item is FileInfo fi && fi.Exists)
			{
				editor.LoadFile(fi.FullName);
			}
			else
			{
			}
		}
	}
}